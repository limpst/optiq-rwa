# Copy to .env (gitignored). Never commit real keys.
DERIBIT_CLIENT_ID=your_client_id
DERIBIT_CLIENT_SECRET=your_client_secret
# Deribit key scope: a read-only key (account:read, trade:read) is enough. Paper trading never sends orders.
OPTIQ_DB=data/optiq.db
OPTIQ_MIN_DAILY_VOLUME_KRW=1000000000
OPTIQ_USDKRW=1400
